{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/((?!robots\\.txt|sitemap\\.xml|favicon\\.ico|llms\\.txt|llms-full\\.txt).*)",
      "has": [
        {
          "type": "host",
          "value": "guptasevergreendevelopers.com"
        }
      ],
      "destination": "https://www.guptasevergreendevelopers.com/$1",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "guptasevergreendevelopers.com"
        }
      ],
      "destination": "https://www.guptasevergreendevelopers.com/",
      "statusCode": 301
    },
    { "source": "/house-construction-cost-dehradun-2026", "destination": "/articles/house-construction-cost-dehradun-2026", "statusCode": 301 },
    { "source": "/best-construction-companies-dehradun", "destination": "/articles/best-construction-companies-dehradun", "statusCode": 301 },
    { "source": "/house-construction-contractors-dehradun", "destination": "/articles/house-construction-contractors-dehradun", "statusCode": 301 },
    { "source": "/turnkey-house-construction-dehradun", "destination": "/articles/turnkey-house-construction-dehradun", "statusCode": 301 },
    { "source": "/villa-construction-mussoorie", "destination": "/articles/villa-construction-mussoorie", "statusCode": 301 },
    { "source": "/construction-cost-calculator-dehradun", "destination": "/articles/construction-cost-calculator-dehradun", "statusCode": 301 },
    { "source": "/mdda-building-approval-guide-dehradun", "destination": "/articles/mdda-building-approval-guide-dehradun", "statusCode": 301 },
    { "source": "/house-construction-timeline-dehradun", "destination": "/articles/house-construction-timeline-dehradun", "statusCode": 301 },
    { "source": "/construction-materials-and-specifications", "destination": "/articles/construction-materials-and-specifications", "statusCode": 301 },
    { "source": "/completed-projects-dehradun", "destination": "/articles/completed-projects-dehradun", "statusCode": 301 },
    { "source": "/construction-company-comparison-guide-dehradun", "destination": "/articles/construction-company-comparison-guide-dehradun", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|images/|robots\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt|favicon\\.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'none';"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt|favicon\\.ico)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    }
  ]
}
